{
	"info": {
		"_postman_id": "bssc-backend-api-v1",
		"name": "Beasiswa Sultra Cerdas - API Backend",
		"description": "Koleksi API Postman lengkap untuk pengujian backend Beasiswa Sultra Cerdas sebelum Connection Sprint dengan Frontend.",
