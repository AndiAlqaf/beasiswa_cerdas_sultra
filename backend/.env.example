# ============================================
# Beasiswa Sultra Cerdas — Backend Environment Template
# ============================================

# Server
PORT=5000
NODE_ENV=development

# JWT Secrets
JWT_ACCESS_SECRET=your_super_secret_access_key
JWT_REFRESH_SECRET=your_super_secret_refresh_key
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS — Frontend URL
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# File Upload
MAX_FILE_SIZE=2097152
UPLOAD_DIR=

# ============================================
# Email SMTP — Brevo (https://brevo.com)
# ============================================
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_login
SMTP_PASS=your_brevo_smtp_key
EMAIL_FROM=Beasiswa Sultra Cerdas <noreply@bssc.sultraprov.go.id>

# Jadwal Blast Email Pengumuman Kelulusan (YYYY-MM-DD)
ANNOUNCEMENT_DATE=2026-10-16

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=beasiswa_sultra_cerdas
DB_CONNECTION_LIMIT=20
